{
  "name": "stitchsense-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "migrate": "node dist/scripts/apply-migrations.js",
    "audit:platform-data": "node dist/scripts/audit-platform-data.js",
    "audit:wordpress-export": "node dist/scripts/audit-wordpress-export.js",
    "migration:wordpress": "node dist/scripts/import-wordpress-library.js",
    "seed:demo": "node dist/scripts/seed-demo-user.js",
    "validate:pattern-files": "node dist/scripts/validate-pattern-file-links.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.12.1",
    "fastify-raw-body": "^5.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
