NODE_ENV=production
PORT=8080
LOG_LEVEL=info
SLOW_REQUEST_MS=3000
METRICS_SHARED_SECRET=replace-with-long-random-staging-metrics-secret
READINESS_CHECK_TIMEOUT_MS=2000
PUBLIC_API_BASE_URL=https://staging-stitchsense.zu-auto.co.uk

CORS_ORIGINS=https://catlowyarns.co.uk,https://www.catlowyarns.co.uk
TRUST_PROXY=127.0.0.1
MAX_PATTERN_UPLOAD_BYTES=115343360

DATABASE_URL=postgres://stitchsense_staging:replace-with-staging-postgres-password@postgres:5432/stitchsense_staging
JWT_SECRET=replace-with-a-long-random-staging-secret

N8N_CHAT_URL=https://n8n.zu-auto.co.uk/webhook/pattern-helper-chat
N8N_UPLOAD_URL=https://n8n.zu-auto.co.uk/webhook/stitchsense-upload-v5
N8N_LIBRARY_PROXY_URL=https://n8n.zu-auto.co.uk/webhook/stitchsense-library-proxy
N8N_IMAGE_URL=https://n8n.zu-auto.co.uk/webhook/stitchsense-image-analysis
N8N_SHARED_SECRET=replace-with-staging-or-shared-n8n-secret
N8N_CHAT_SHARED_SECRET=replace-with-chat-workflow-secret
N8N_UPLOAD_SHARED_SECRET=replace-with-upload-workflow-secret

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_BUCKET=stitchsense-patterns-staging
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-staging-minio-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-staging-minio-secret-key

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT_ID=pro

WORDPRESS_BRIDGE_SHARED_SECRET=replace-with-staging-wordpress-bridge-secret
WORDPRESS_SITE_URL=https://catlowyarns.co.uk
