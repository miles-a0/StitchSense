N8N_SHARED_SECRET=replace-with-long-random-staging-n8n-secret
N8N_CHAT_SHARED_SECRET=replace-with-long-random-chat-workflow-secret
N8N_UPLOAD_SHARED_SECRET=replace-with-long-random-upload-workflow-secret

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_BUCKET=stitchsense-patterns-staging
OBJECT_STORAGE_REGION=us-east-1
