NODE_ENV=production
PORT=8080
LOG_LEVEL=info
SLOW_REQUEST_MS=3000
METRICS_SHARED_SECRET=replace-with-long-random-metrics-secret
READINESS_CHECK_TIMEOUT_MS=2000
PUBLIC_API_BASE_URL=https://stitchsense.zu-auto.co.uk

# Existing VPS PostgreSQL container is reachable at 173.249.40.161:2303.
# Use a dedicated database so the mobile platform schema does not collide with WordPress/plugin tables.
DATABASE_URL=postgres://stitchsense_user:replace-with-live-postgres-password@173.249.40.161:2303/stitchsense_mobile

# Generate a long random value before deploying.
JWT_SECRET=replace-with-a-long-random-production-secret

# n8n stays server-side. Use the internal/public webhook URLs from your live workflows.
N8N_CHAT_URL=https://n8n.zu-auto.co.uk/webhook/pattern-helper-chat
N8N_UPLOAD_URL=https://n8n.zu-auto.co.uk/webhook/stitchsense-upload-v5
N8N_LIBRARY_PROXY_URL=https://n8n.zu-auto.co.uk/webhook/stitchsense-library-proxy
N8N_IMAGE_URL=https://n8n.zu-auto.co.uk/webhook/stitchsense-image-analysis
N8N_SHARED_SECRET=replace-with-shared-n8n-secret
# Chat uses the n8n pattern-helper-chat workflow secret. It can be different from N8N_SHARED_SECRET.
N8N_CHAT_SHARED_SECRET=replace-with-chat-workflow-secret
# Upload uses the n8n STITCHSENSE_UPLOAD_SECRET. It can be different from N8N_SHARED_SECRET.
N8N_UPLOAD_SHARED_SECRET=replace-with-upload-workflow-secret

# S3-compatible storage. For production, prefer your existing/object storage provider.
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_BUCKET=stitchsense-patterns
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=http://host.docker.internal:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-storage-secret-key

# Billing can stay blank for API smoke tests, then be filled before paid beta.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT_ID=pro

# Only needed when linking the WordPress plugin into the shared platform API.
WORDPRESS_BRIDGE_SHARED_SECRET=replace-with-wordpress-bridge-secret
WORDPRESS_SITE_URL=https://catlowyarns.co.uk
