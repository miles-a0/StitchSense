[{'@expo/vector-icons': 'import { useRouter'}, {'react-native': 'import { AppCard'}, {'@/src/components/ui/brand-button': 'import { ScreenHero'}, {'@/src/lib/making-insights': 'import { describeStashItem'}, {'@/src/providers/library-provider': 'import { useProjects'}, {'@/src/providers/stash-provider': 'import { tokens'}, {'quantity?': 'string'}, {'parsed': None, 'isLowStash(item': {'quantity?': 'string; unit?: string'}, "g' || unit === 'gram' || unit === 'grams') return quantity <= 25;\n  if (unit.includes('skein') || unit.includes('ball') || unit.includes('hank": 'return quantity <= 1;\n  return quantity <= 1;'}, {'items': 'stashItems'}, [0], [0], [{'label': 'Active', 'value': 'activeProjectCount', 'route': '/(tabs)/workspace?filter=active', "paused') ??\n    projects.find((project) => {\n      const idleDays = daysSince(project.lastWorkedAt ?? project.updatedAt ?? project.createdAt);\n      return project.status === 'active": 'idleDays !== null && idleDays >= 7;'}, None, "const quietProjectIdleDays = quietProject\n    ? daysSince(quietProject.lastWorkedAt ?? quietProject.updatedAt ?? quietProject.createdAt)\n    : null;\n  const toolRecommendation = quietProject\n    ? {\n        kicker: 'Recommended now',\n        title: 'Project restart helper',\n        copy: `${quietProject.title} could use a gentle pick-up plan${quietProjectIdleDays ? ` after ${quietProjectIdleDays} days` : ''}.`,\n        label: 'Open restart helper',\n        onPress: () =>\n          router.push({\n            pathname: '/helper-chat',\n            params: {\n              title: 'Project restart helper',\n              starter: `Please help me restart ${quietProject.title}. Give me a short, low-friction plan for checking where I left off, what to prepare, and what to do first.`,\n              context: `Project: ${quietProject.title}. Status: ${quietProject.status}. Stage: ${quietProject.stageLabel}.`,\n              toolMode: 'project_restart_helper',\n            },\n          }),\n      }\n    : lowStashItem\n    ? {\n        kicker: 'Recommended now',\n        title: 'Leftover and restock helper',\n        copy: `${describeStashItem(lowStashItem)} is running low. Get ideas for leftovers or what to buy next.`,\n        label: 'Open stash helper',\n        onPress: () =>\n          router.push({\n            pathname: '/helper-chat',\n            params: {\n              title: 'Leftover and restock helper',\n              starter: `I have a low amount of ${describeStashItem(lowStashItem)}. Please suggest realistic leftover uses and what to record or buy if I need more.`,\n              context: `Low stash item: ${describeStashItem(lowStashItem)}`,\n              toolMode: 'stash_restock_helper',\n            },\n          }),\n      }\n    : completedProject\n      ? {\n          kicker: 'Recommended now',\n          title: 'Finishing and care helper',\n          copy: `${completedProject.title} is complete. Get a care, blocking, and storage checklist.`,\n          label: 'Open finishing helper',\n          onPress: () =>\n            router.push({\n              pathname: '/helper-chat',\n              params: {\n                title: 'Finishing and care helper',\n                starter: `Please help me finish, care for, and store ${completedProject.title}.`,\n                context: `Completed project: ${completedProject.title}`,\n                toolMode: 'project_finishing_helper',\n              },\n            }),\n        }\n      : projectFocus\n    ? {\n        kicker: 'Recommended now',\n        title: 'Project planning helper',\n        copy: `${projectFocus.copy} Ask for a short, practical plan before you continue.`,\n        label: 'Open project helper',\n        onPress: () =>\n          router.push({\n            pathname: '/helper-chat',\n            params: {\n              title: 'Project next-step helper',\n              starter: `${projectFocus.copy} Please help me choose the next practical step and what to check first.`,\n              context: `Project: ${projectFocus.project.title}`,\n              toolMode: 'project_next_step_helper',\n            },\n          }),\n      }\n    : firstYarn\n      ? {\n          kicker: 'Recommended now',\n          title: 'Stash idea helper',\n          copy: `Use ${describeStashItem(firstYarn)} as the starting point for realistic project ideas.`,\n          label: 'Open stash helper',\n          onPress: () =>\n            router.push({\n              pathname: '/helper-chat',\n              params: {\n                title: 'Stash idea helper',\n                starter: `What could I make with ${describeStashItem(firstYarn)}? Please suggest realistic knitting or crochet ideas.`,\n                context: `Known stash item: ${describeStashItem(firstYarn)}`,\n                toolMode: 'stash_idea_helper',\n              },\n            }),\n        }\n      : patterns[0]\n        ? {\n            kicker: 'Recommended now',\n            title: 'Pattern understanding helper',\n            copy: `Get help understanding ${patterns[0].title} before starting.`,\n            label: 'Open pattern helper',\n            onPress: () =>\n              router.push({\n                pathname: '/pattern-chat',\n                params: { patternId: patterns[0].id },\n              }),\n          }\n        : null;\n\n  return (\n    <ScrollView contentContainerStyle={styles.content} style={styles.screen}>\n      <ScreenHero\n        copy=", 'Focused helpers for the moments where a calm second opinion, a calculation, or a plain-English explanation saves time."\n        eyebrow="Smart Assistants"\n        icon="hammer-wrench"\n        title=', 'Specialist help, without the clutter">\n        <View style={styles.heroChip}>\n          <Text style={styles.heroChipEyebrow}>Guided support</Text>\n          <Text style={styles.heroChipTitle}>Pattern-aware helpers</Text>\n        </View>\n      </ScreenHero>\n\n      {toolRecommendation ? (\n        <AppCard elevated style={styles.recommendedCard}>\n          <Text style={styles.cardKicker}>{toolRecommendation.kicker}</Text>\n          <Text style={styles.recommendedTitle}>{toolRecommendation.title}</Text>\n          <Text style={styles.cardCopy}>{toolRecommendation.copy}</Text>\n          <BrandButton\n            label={toolRecommendation.label}\n            onPress={toolRecommendation.onPress}\n            style={styles.fullWidth}\n          />\n        </AppCard>\n      ) : null}\n\n      <AppCard elevated style={styles.directoryCard}>\n        <Text style={styles.cardKicker}>Assistant directory</Text>\n        <Text style={styles.recommendedTitle}>Choose the helper by the kind of problem</Text>\n        <View style={styles.statGrid}>\n          {helperStats.map((stat) => (\n            <Pressable\n              key={stat.label}\n              onPress={() => router.push(stat.route)}\n              style={styles.statTile}>\n              <Text style={styles.statValue}>{stat.value}</Text>\n              <Text style={styles.statLabel}>{stat.label}</Text>\n            </Pressable>\n          ))}\n        </View>\n        <View style={styles.quickHelperRow}>\n          <Pressable\n            onPress={() => router.push(\'/(tabs)/camera\')}\n            style={styles.quickHelper}>\n            <MaterialCommunityIcons color={tokens.color.primary} name="camera-outline" size={20} />\n            <Text style={styles.quickHelperText}>Photo help</Text>\n          </Pressable>\n          <Pressable\n            onPress={() => router.push(\'/(tabs)/chat\')}\n            style={styles.quickHelper}>\n            <MaterialCommunityIcons color={tokens.color.primary} name="message-text-outline" size={20} />\n            <Text style={styles.quickHelperText}>General chat</Text>\n          </Pressable>\n          <Pressable\n            onPress={() => router.push(\'/ravelry\')}\n            style={styles.quickHelper}>\n            <MaterialCommunityIcons color={tokens.color.primary} name="magnify', 'size={20} />\n            <Text style={styles.quickHelperText}>Find patterns</Text>\n          </Pressable>\n        </View>\n      </AppCard>\n\n      {(firstPattern || firstYarn) ? (\n        <AppCard elevated style={styles.contextCard}>\n          <Text style={styles.cardKicker}>Use your own data</Text>\n          <Text style={styles.cardTitle}>Start with what StitchSense already knows</Text>\n          <View style={styles.contextActionList}>\n            {firstPattern ? (\n              <Pressable\n                onPress={() =>\n                  router.push({\n                    pathname: \'/pattern-chat\',\n                    params: { patternId: firstPattern.id },\n                  })\n                }\n                style={styles.contextAction}>\n                <View style={styles.contextIcon}>\n                  <MaterialCommunityIcons color={tokens.color.primary} name="file-document-outline', 'size={19} />\n                </View>\n                <View style={styles.contextCopyBlock}>\n                  <Text style={styles.contextTitle}>Ask about a pattern</Text>\n                  <Text style={styles.contextCopy}>{firstPattern.title}</Text>\n                </View>\n              </Pressable>\n            ) : null}\n            {firstYarn ? (\n              <Pressable\n                onPress={() =>\n                  router.push({\n                    pathname: \'/helper-chat\',\n                    params: {\n                      title: \'Stash idea helper\',\n                      starter: `What could I make with ${describeStashItem(firstYarn)}? Please suggest realistic knitting or crochet ideas.`,\n                      context: `Known stash item: ${describeStashItem(firstYarn)}`,\n                      toolMode: \'stash_idea_helper\',\n                    },\n                  })\n                }\n                style={styles.contextAction}>\n                <View style={styles.contextIcon}>\n                  <MaterialCommunityIcons color={tokens.color.primary} name="basket-outline', 'size={19} />\n                </View>\n                <View style={styles.contextCopyBlock}>\n                  <Text style={styles.contextTitle}>Ask from stash</Text>\n                  <Text style={styles.contextCopy}>{describeStashItem(firstYarn)}</Text>\n                </View>\n              </Pressable>\n            ) : null}\n          </View>\n        </AppCard>\n      ) : null}\n\n      <View style={[styles.grid, compact ? styles.gridCompact : null]}>\n        <AppCard elevated style={styles.card}>\n          <Text style={styles.cardKicker}>Tension & fit</Text>\n          <Text style={styles.cardTitle}>Gauge Assistant</Text>\n          <Text style={styles.cardCopy}>\n            Check stitch and row gauge, compare block sizes, and get a plain-English recommendation for your next swatch.\n          </Text>\n          <BrandButton\n            label="Open Gauge Assistant', 'onPress={() => router.push(\'/gauge-calculator\')}\n            style={styles.fullWidth}\n          />\n        </AppCard>\n\n        <AppCard elevated style={styles.card}>\n          <Text style={styles.cardKicker}>Reference</Text>\n          <Text style={styles.cardTitle}>Technique Coach</Text>\n          <Text style={styles.cardCopy}>\n            Browse the full stitch glossary with search, category filters, sort modes, and UK/US terminology support.\n          </Text>\n          <BrandButton\n            label="Open Technique Coach"\n            onPress={() => router.push(\'/stitch-dictionary\')}\n            style={styles.fullWidth}\n            variant="ghost', 'AppCard>\n\n        <AppCard elevated style={styles.card}>\n          <Text style={styles.cardKicker}>Decision support</Text>\n          <Text style={styles.cardTitle}>Yarn Assistant</Text>\n          <Text style={styles.cardCopy}>\n            Get practical help swapping yarns while keeping the pattern behaviour, fabric feel, and gauge risk sensible.\n          </Text>\n          <BrandButton\n            label="Open Yarn Assistant', 'onPress={() =>\n              router.push({\n                pathname: \'/helper-chat\',\n                params: {\n                  title: \'Yarn substitution helper\',\n                  starter:\n                    \'I want help substituting yarn for a pattern. Please tell me what to compare first and what risks to watch for.\',\n                  context:\n                    \'The user opened the Yarn substitution helper from the Expo tools screen.\',\n                  toolMode: \'yarn_substitution_helper\',\n                },\n              })\n            }\n            style={styles.fullWidth}\n            variant="secondary', 'AppCard>\n\n        <AppCard elevated style={styles.card}>\n          <Text style={styles.cardKicker}>Garment fit</Text>\n          <Text style={styles.cardTitle}>Fit & Ease Assistant</Text>\n          <Text style={styles.cardCopy}>\n            Sanity-check intended ease, finished size, and whether a pattern is likely to land how you want it to.\n          </Text>\n          <BrandButton\n            label="Open Fit Assistant', 'onPress={() =>\n              router.push({\n                pathname: \'/helper-chat\',\n                params: {\n                  title: \'Ease and fit check\',\n                  starter:\n                    \'Please help me understand pattern ease, finished measurements, and how to choose the right size.\',\n                  context:\n                    \'The user opened the Ease and fit check helper from the Expo tools screen.\',\n                  toolMode: \'ease_check_helper\',\n                },\n              })\n            }\n            style={styles.fullWidth}\n            variant="ghost', 'AppCard>\n\n        <AppCard elevated style={styles.card}>\n          <Text style={styles.cardKicker}>Fabric control</Text>\n          <Text style={styles.cardTitle}>Needle & Hook Assistant</Text>\n          <Text style={styles.cardCopy}>\n            Work out whether to size up, size down, or leave things alone based on gauge, drape, and project type.\n          </Text>\n          <BrandButton\n            label="Open Needle & Hook Assistant', 'onPress={() =>\n              router.push({\n                pathname: \'/helper-chat\',\n                params: {\n                  title: \'Needle and hook direction\',\n                  starter:\n                    \'Should I size my needle or hook up or down, and what should I look for in the next swatch?\',\n                  context:\n                    \'The user opened the Needle / hook helper from the Expo tools screen.\',\n                  toolMode: \'needle_hook_helper\',\n                },\n              })\n            }\n            style={styles.fullWidth}\n            variant="ghost', "AppCard>\n\n      </View>\n    </ScrollView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  screen: {\n    flex: 1,\n    backgroundColor: tokens.color.background,\n  },\n  content: {\n    padding: tokens.spacing.lg,\n    gap: tokens.spacing.xl2,\n  },\n  grid: {\n    gap: tokens.spacing.lg,\n  },\n  gridCompact: {\n    gap: tokens.spacing.md,\n  },\n  card: {\n    gap: tokens.spacing.md,\n    padding: tokens.spacing.xl,\n  },\n  recommendedCard: {\n    gap: tokens.spacing.md,\n    padding: tokens.spacing.xl,\n    backgroundColor: '#fffaf4',\n    borderColor: '#dbc3ac',\n  },\n  directoryCard: {\n    gap: tokens.spacing.md,\n    padding: tokens.spacing.xl,\n    backgroundColor: '#f4fbfb',\n    borderColor: '#c5e1df',\n  },\n  statGrid: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: tokens.spacing.sm,\n  },\n  statTile: {\n    width: '48%',\n    minHeight: 76,\n    borderRadius: tokens.radius.large,\n    borderWidth: 1,\n    borderColor: tokens.color.border,\n    backgroundColor: tokens.color.surface,\n    padding: tokens.spacing.md,\n    justifyContent: 'center',\n    gap: 2,\n  },\n  statValue: {\n    color: tokens.color.text,\n    fontSize: 23,\n    fontWeight: '900',\n  },\n  statLabel: {\n    color: tokens.color.muted,\n    fontSize: 12,\n    lineHeight: 16,\n    fontWeight: '800',\n  },\n  quickHelperRow: {\n    flexDirection: 'row',\n    flexWrap: 'wrap',\n    gap: tokens.spacing.sm,\n  },\n  quickHelper: {\n    flexGrow: 1,\n    minWidth: 120,\n    minHeight: 58,\n    borderRadius: tokens.radius.large,\n    borderWidth: 1,\n    borderColor: tokens.color.border,\n    backgroundColor: tokens.color.surface,\n    paddingHorizontal: tokens.spacing.md,\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: tokens.spacing.sm,\n  },\n  quickHelperText: {\n    color: tokens.color.primary,\n    fontSize: 13,\n    fontWeight: '900',\n  },\n  contextCard: {\n    gap: tokens.spacing.md,\n    padding: tokens.spacing.xl,\n    backgroundColor: '#fffaf4',\n    borderColor: '#dbc3ac',\n  },\n  contextActionList: {\n    gap: tokens.spacing.sm,\n  },\n  contextAction: {\n    minHeight: 74,\n    borderRadius: tokens.radius.large,\n    borderWidth: 1,\n    borderColor: tokens.color.border,\n    backgroundColor: tokens.color.surface,\n    padding: tokens.spacing.md,\n    flexDirection: 'row',\n    alignItems: 'center',\n    gap: tokens.spacing.md,\n  },\n  contextIcon: {\n    width: 38,\n    height: 38,\n    borderRadius: tokens.radius.large,\n    backgroundColor: '#f6eadf',\n    alignItems: 'center',\n    justifyContent: 'center',\n  },\n  contextCopyBlock: {\n    flex: 1,\n    gap: 3,\n  },\n  contextTitle: {\n    color: tokens.color.text,\n    fontSize: 14,\n    fontWeight: '900',\n  },\n  contextCopy: {\n    color: tokens.color.muted,\n    fontSize: 13,\n    lineHeight: 18,\n  },\n  recommendedTitle: {\n    color: tokens.color.text,\n    fontSize: 22,\n    lineHeight: 28,\n    fontWeight: '900',\n  },\n  heroChip: {\n    gap: 4,\n  },\n  heroChipEyebrow: {\n    color: tokens.color.accent,\n    fontSize: 11,\n    fontWeight: '800',\n    letterSpacing: 0.8,\n    textTransform: 'uppercase',\n  },\n  heroChipTitle: {\n    color: tokens.color.text,\n    fontSize: 16,\n    fontWeight: '700',\n  },\n  cardKicker: {\n    color: tokens.color.accent,\n    fontSize: 12,\n    fontWeight: '800',\n    textTransform: 'uppercase',\n    letterSpacing: 0.5,\n  },\n  cardTitle: {\n    color: tokens.color.text,\n    fontSize: 22,\n    lineHeight: 28,\n    fontWeight: '800',\n  },\n  cardCopy: {\n    color: tokens.color.muted,\n    fontSize: 15,\n    lineHeight: 22,\n  },\n  fullWidth: {\n    width: '100%',\n    marginTop: tokens.spacing.sm,\n  },\n});"]]