import { useRouter } from 'expo-router';
import React from 'react';
import { Image, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';

import { AppCard } from '@/src/components/ui/app-card';
import { ScreenHero } from '@/src/components/ui/screen-hero';
import { useLibrary } from '@/src/providers/library-provider';
import { useProjects } from '@/src/providers/projects-provider';
import { useSession } from '@/src/providers/session-provider';
import { useStash } from '@/src/providers/stash-provider';
import { tokens } from '@/src/theme/tokens';

type JourneyCardProps = {
  src: number;
  title: string;
  copy: string;
  action: string;
  onPress: () => void;
};

function JourneyCard({ src, title, copy, action, onPress }: JourneyCardProps) {
  return (
    <Pressable
      accessibilityRole="button"
      onPress={onPress}
      style={({ pressed }) => [styles.journeyCard, pressed ? styles.pressed : null]}>
      <View style={styles.journeyIcon}>
        <Image source={src} style={{ width: 22, height: 22 }} />
      </View>
      <View style={styles.journeyCopyBlock}>
        <Text style={styles.journeyTitle}>{title}</Text>
        <Text style={styles.journeyCopy}>{copy}</Text>
        <Text style={styles.journeyAction}>{action}</Text>
      </View>
    </Pressable>
  );
}

function MiniAction({
  src,
  label,
  onPress,
}: {
  src: number;
  label: string;
  onPress: () => void;
}) {
  return (
    <Pressable
      onPress={onPress}
      style={({ pressed }) => [styles.miniAction, pressed ? styles.pressed : null]}>
      <Image source={src} style={{ width: 19, height: 19 }} />
      <Text style={styles.miniActionLabel}>{label}</Text>
    </Pressable>
  );
}

export default function DashboardScreen() {
  const router = useRouter();
  const { user } = useSession();
  const { patterns } = useLibrary();
  const { projects } = useProjects();
  const { items: stashItems } = useStash();
  const displayName = user?.displayName ?? user?.email ?? 'StitchSense maker';
  const commandTiles = [
    {
      src: require('../../assets/images/Library.png'),
      label: 'Library',
      value: 'Master patterns',
      onPress: () => router.push('/(tabs)/library'),
    },
    {
      src: require('../../assets/images/Projects.png'),
      label: 'Projects',
      value: 'Project clones',
      onPress: () => router.push('/(tabs)/workspace'),
    },
    {
      src: require('../../assets/images/Stash.png'),
      label: 'Stash',
      value: 'Supplies',
      onPress: () => router.push('/(tabs)/stash'),
    },
    {
      src: require('../../assets/images/Chat.png'),
      label: 'Chat',
      value: 'Ask anything',
      onPress: () => router.push('/(tabs)/chat'),
    },
    {
      src: require('../../assets/images/Tools.png'),
      label: 'Tools',
      value: 'Helpers',
      onPress: () => router.push('/(tabs)/tools'),
    },
    {
      src: require('../../assets/images/Account.png'),
      label: 'Account',
      value: 'Settings',
      onPress: () => router.push('/(tabs)/account'),
    },
  ];

  return (
    <ScrollView contentContainerStyle={styles.content} style={styles.screen}>
      <ScreenHero
        copy="Start with a pattern, your yarn, a current project, a stuck moment, or a general question. StitchSense will keep the next step clear."
        eyebrow="Home"
        icon="cog-outline"
        iconAccessibilityLabel="Manage account"
        onIconPress={() => router.push('/(tabs)/account')}
        title={`Welcome back, ${displayName}`}>
        <View style={styles.heroStats}>
          <View style={styles.heroStat}>
            <Text style={styles.heroStatValue}>{patterns.length}</Text>
            <Text style={styles.heroStatLabel}>Patterns</Text>
          </View>
          <View style={styles.heroStat}>
            <Text style={styles.heroStatValue}>{projects.length}</Text>
            <Text style={styles.heroStatLabel}>Projects</Text>
          </View>
          <View style={styles.heroStat}>
            <Text style={styles.heroStatValue}>{stashItems.length}</Text>
            <Text style={styles.heroStatLabel}>Stash</Text>
          </View>
        </View>
      </ScreenHero>

      <AppCard elevated style={styles.cockpitCard}>
        <View style={styles.cockpitHeader}>
          <View style={styles.cockpitHeaderCopy}>
            <Text style={styles.eyebrow}>App navigation</Text>
            <Text style={styles.foundationTitle}>Choose the area you want to work in</Text>
          </View>
        </View>
        <View style={styles.commandGrid}>
          {commandTiles.map((tile) => (
            <Pressable
              key={`${tile.label}-${tile.value}`}
              onPress={tile.onPress}
              style={({ pressed }) => [styles.commandTile, pressed ? styles.pressed : null]}>
              <Image source={tile.src} style={{ width: 21, height: 21 }} />
              <Text style={styles.commandLabel}>{tile.label}</Text>
              <Text numberOfLines={1} style={styles.commandValue}>{tile.value}</Text>
            </Pressable>
          ))}
        </View>
      </AppCard>

      <View style={styles.sectionHeader}>
        <Text style={styles.eyebrow}>Guided routes</Text>
        <Text style={styles.sectionTitle}>Quick Starts</Text>
      </View>

      <View style={styles.journeyGrid}>
        <JourneyCard
          src={require('../../assets/images/Pattern.png')}
          title="I have a pattern"
          copy="Upload, import, understand difficulty, choose size, and check yarn before starting."
          action="Open Library"
          onPress={() => router.push('/(tabs)/library')}
        />
        <JourneyCard
          src={require('../../assets/images/Yarn.png')}
          title="I have yarn"
          copy="Record stash, compare what you own, and ask for project ideas from real supplies."
          action="Open Stash"
          onPress={() => router.push('/(tabs)/stash')}
        />
        <JourneyCard
          src={require("../../assets/images/I-Am-Stuck.png")}
          title="I'm stuck"
          copy="Ask a general question, decode a technique, or use photo help for a tricky stitch."
          action="Ask StitchSense"
          onPress={() => router.push('/(tabs)/chat')}
        />
        <JourneyCard
          src={require('../../assets/images/Current-Project.png')}
          title="I'm actively making"
          copy="Continue a project, track progress, save photos, and keep counters close."
          action="Open Projects"
          onPress={() => router.push('/(tabs)/workspace')}
        />
      </View>

      <AppCard style={styles.smartCard}>
        <Text style={styles.eyebrow}>Smart Assistants</Text>
        <Text style={styles.sectionTitle}>Focused help when you need it</Text>
        <Text style={styles.smartCopy}>
          Calculators and specialist helpers now live together as assistants, so the main app stays simple.
        </Text>
        <View style={styles.miniGrid}>
          <MiniAction src={require('../../assets/images/Gauge.png')} label="Gauge" onPress={() => router.push('/gauge-calculator')} />
          <MiniAction src={require('../../assets/images/Yarn-Swap.png')} label="Yarn swap" onPress={() => router.push('/(tabs)/tools')} />
          <MiniAction src={require('../../assets/images/Dictionary.png')} label="Dictionary" onPress={() => router.push('/stitch-dictionary')} />
          <MiniAction src={require('../../assets/images/Stitch-Vision.png')} label="Stitch Vision" onPress={() => router.push('/(tabs)/camera')} />
        </View>
      </AppCard>
    </ScrollView>
  );
}

