{
  "name": "stitchsense-expo",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "bash ../../tools/start-stitchsense-expo.sh",
    "start:go": "bash ../../tools/start-stitchsense-expo.sh",
    "start:go:tunnel": "bash ../../tools/start-stitchsense-expo.sh tunnel",
    "doctor": "bash ../../tools/start-stitchsense-expo.sh doctor",
    "reset-project": "bash ../../tools/run-with-node22.sh node ./scripts/reset-project.js",
    "android": "bash ../../tools/run-with-node22.sh npx expo start --android",
    "ios": "bash ../../tools/run-with-node22.sh npx expo start --ios",
    "web": "bash ../../tools/run-with-node22.sh npx expo start --web",
    "build:dev:ios": "bash ../../tools/run-with-node22.sh npx eas build --profile development --platform ios",
    "build:dev:android": "bash ../../tools/run-with-node22.sh npx eas build --profile development --platform android",
    "build:preview:ios": "bash ../../tools/run-with-node22.sh npx eas build --profile preview --platform ios",
    "build:preview:android": "bash ../../tools/run-with-node22.sh npx eas build --profile preview --platform android",
    "build:prod:ios": "bash ../../tools/run-with-node22.sh npx eas build --profile production --platform ios",
    "build:prod:android": "bash ../../tools/run-with-node22.sh npx eas build --profile production --platform android",
    "eas-build-pre-install": "node ./scripts/validate-release-config.mjs --eas-hook",
    "check:capture-script": "bash ../../tools/run-with-node22.sh node --check ./scripts/capture-app-screenshots.cjs",
    "check:mobile-artifacts": "bash ../../tools/run-with-node22.sh node ../../tools/validate-mobile-release-artifacts.mjs",
    "check:release-config": "bash ../../tools/run-with-node22.sh node ./scripts/validate-release-config.mjs --require-revenuecat",
    "lint": "bash ../../tools/run-with-node22.sh npx expo lint --max-warnings=0",
    "test": "bash ../../tools/run-with-node22.sh npx tsx --test tests/*.test.ts",
    "typecheck": "bash ../../tools/run-with-node22.sh npx tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~57.0.28",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10"
  }
}
