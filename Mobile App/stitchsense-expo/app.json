{
  "expo": {
    "name": "StitchSense",
    "slug": "stitchsense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "stitchsense",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.zuauto.stitchsense",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "StitchSense uses your camera so Stitch Vision can analyse knitting and crochet images you choose.",
        "NSPhotoLibraryUsageDescription": "StitchSense uses your photo library so you can upload pattern, project, and stash images you choose.",
        "NSPhotoLibraryAddUsageDescription": "StitchSense can save generated or selected making images when you ask it to."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff7ef",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "uk.co.zuauto.stitchsense",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fff7ef"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "StitchSense uses your photos so Stitch Vision can analyse knitting and crochet images.",
          "cameraPermission": "StitchSense uses your camera so Stitch Vision can analyse knitting and crochet images.",
          "microphonePermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://stitchsense.zu-auto.co.uk",
      "wordpressBaseUrl": "https://catlowyarns.co.uk",
      "revenueCatIosApiKey": "",
      "revenueCatAndroidApiKey": "",
      "revenueCatEntitlementId": "pro"
    }
  }
}
